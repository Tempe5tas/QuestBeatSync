<Window
    x:Class="QuestBeatSync.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:QuestBeatSync.Core.Models"
    xmlns:vm="using:QuestBeatSync.App.ViewModels"
    Title="QuestBeatSync"
    Width="1000"
    Height="680"
    MinWidth="760"
    MinHeight="500"
    DragDrop.AllowDrop="True"
    DragDrop.DragOver="OnDragOver"
    DragDrop.Drop="OnDrop">
  <Grid ColumnDefinitions="220,*">
    <Border Background="#171A21" Padding="20,24">
      <Grid RowDefinitions="Auto,24,*">
        <StackPanel>
          <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="White" Text="QuestBeatSync" />
          <TextBlock Margin="0,4,0,0" Foreground="#9BA3B4" Text="Quest library manager" />
        </StackPanel>

        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding NavigationItems}"
            SelectedItem="{Binding SelectedPage}"
            Background="Transparent"
            BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <TextBlock Margin="12,10" FontSize="15" Foreground="White" Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="40,36" Spacing="24">
        <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}" />

        <StackPanel IsVisible="{Binding IsDashboard}" Spacing="18">
          <Border Padding="20" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" Foreground="#AAB1C0" Text="DEVICE" />
                  <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding DeviceStatus}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshDevicesCommand}"
                    Content="Refresh" />
              </Grid>

              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" />

              <StackPanel IsVisible="{Binding HasDevices}" Spacing="8">
                <TextBlock Foreground="#AAB1C0" Text="Device" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:QuestDevice">
                      <Grid ColumnDefinitions="*,Auto" MinWidth="420">
                        <TextBlock Text="{Binding Serial}" />
                        <TextBlock Grid.Column="1" Margin="20,0,0,0" Foreground="#AAB1C0" Text="{Binding ConnectionState}" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    IsVisible="{Binding HasMultipleDevices}"
                    Foreground="#D7A95B"
                    Text="Multiple devices detected. Select the device to use." />
              </StackPanel>

              <Grid
                  IsVisible="{Binding HasSelectedDevice}"
                  ColumnDefinitions="Auto,24,*"
                  RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock Foreground="#AAB1C0" Text="Serial" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedSerial}" />
                <TextBlock Grid.Row="2" Foreground="#AAB1C0" Text="State" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedConnectionState}" />
                <TextBlock Grid.Row="4" Foreground="#AAB1C0" Text="Transport" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedTransport}" />
                <TextBlock Grid.Row="6" Foreground="#AAB1C0" Text="Android model" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SelectedModel}" />
              </Grid>

              <TextBlock
                  IsVisible="{Binding HasErrorMessage}"
                  Foreground="#E88A8A"
                  Text="{Binding ErrorMessage}"
                  TextWrapping="Wrap" />

              <Button
                  IsVisible="{Binding IsAdbUnavailable}"
                  HorizontalAlignment="Left"
                  Command="{Binding OpenSettingsCommand}"
                  Content="Set ADB path" />
            </StackPanel>
          </Border>

          <Border Padding="20" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="#AAB1C0" Text="BEAT SABER ENVIRONMENT" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsEnvironmentScanning}" />
              <TextBlock Text="{Binding BeatSaberStatus}" />
              <TextBlock Text="{Binding SongCoreStatus}" />
              <TextBlock Text="{Binding PlaylistManagerStatus}" />
              <TextBlock
                  IsVisible="{Binding HasEnvironmentError}"
                  Foreground="#E88A8A"
                  Text="{Binding EnvironmentError}"
                  TextWrapping="Wrap" />
              <TextBlock
                  IsVisible="{Binding HasScanWarnings}"
                  Foreground="#D7A95B"
                  Text="{Binding ScanWarningCount, StringFormat='{}{0} scan warning(s)'}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,18,*">
            <Border Padding="20" CornerRadius="8" Background="#20242D">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" Foreground="#AAB1C0" Text="LIBRARY" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SongCount, StringFormat='{}{0} songs'}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="20" CornerRadius="8" Background="#20242D">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" Foreground="#AAB1C0" Text="PLAYLISTS" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding PlaylistCount, StringFormat='{}{0} playlists'}" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsLibrary}" Spacing="14">
          <TextBlock Foreground="#AAB1C0" Text="Read-only view of CustomLevels" />
          <Border Padding="16" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="2*,2*,1.5*,Auto,1.2*" ColumnSpacing="16">
                <TextBlock FontWeight="SemiBold" Text="Folder" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Song title" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Mapper" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Info.dat" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Identity" />
              </Grid>
              <Border Height="1" Background="#3A404D" />
              <TextBlock
                  IsVisible="{Binding !HasInstalledMaps}"
                  Margin="0,10"
                  Foreground="#8C94A5"
                  Text="No custom songs found." />
              <ItemsControl ItemsSource="{Binding InstalledMaps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:QuestInstalledMap">
                    <Grid Margin="0,7" ColumnDefinitions="2*,2*,1.5*,Auto,1.2*" ColumnSpacing="16">
                      <TextBlock Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RemotePath}" />
                      <TextBlock Grid.Column="1" Text="{Binding SongTitle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Mapper}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{Binding InfoDatExists}" />
                      <TextBlock Grid.Column="4" Text="{Binding IdentityStatus}" ToolTip.Tip="{Binding Warning}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPlaylists}" Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Local playlist imports" />
              <TextBlock Foreground="#AAB1C0" Text="Preview only — nothing is uploaded to Quest." />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="ImportPlaylist_Click"
                Content="Import Playlist" />
          </Grid>

          <Border Padding="18" CornerRadius="8" BorderBrush="#596273" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Drop one or more .bplist files here" />
              <TextBlock Foreground="#8C94A5" Text="BeatSaver playlists are read as UTF-8" />
              <ProgressBar Width="260" IsIndeterminate="True" IsVisible="{Binding IsImportingPlaylists}" />
            </StackPanel>
          </Border>

          <TextBlock
              IsVisible="{Binding HasPlaylistImportErrors}"
              Foreground="#E88A8A"
              Text="{Binding PlaylistImportErrorText}"
              TextWrapping="Wrap" />

          <Grid IsVisible="{Binding HasImportedPlaylists}" ColumnDefinitions="*,12,*,12,*">
            <Border Padding="14" CornerRadius="8" Background="#20242D">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#AAB1C0" Text="TOTAL PLAYLIST REFERENCES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding TotalPlaylistReferences}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#20242D">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#AAB1C0" Text="UNIQUE REQUIRED HASHES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding UniqueRequiredHashes}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="14" CornerRadius="8" Background="#20242D">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#AAB1C0" Text="DUPLICATE REFERENCES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DuplicateReferences}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border IsVisible="{Binding HasImportedPlaylists}" Padding="16" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="14">
              <ComboBox ItemsSource="{Binding ImportedPlaylists}" SelectedItem="{Binding SelectedImportedPlaylist}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Playlist">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel IsVisible="{Binding HasSelectedImportedPlaylist}" Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SelectedImportedPlaylist.Name}" />
                <TextBlock FontSize="16" Foreground="#AAB1C0" Text="{Binding SelectedPlaylistAuthorDisplay}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="18">
                  <TextBlock Text="{Binding SelectedPlaylistEntryCount, StringFormat='{}{0} entries'}" />
                  <TextBlock Text="{Binding SelectedPlaylistUniqueHashCount, StringFormat='{}{0} unique hashes'}" />
                  <TextBlock Text="{Binding SelectedPlaylistDuplicateReferenceCount, StringFormat='{}{0} duplicate references'}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                  <Button Command="{Binding CheckBeatSaverCommand}" Content="Check BeatSaver" />
                  <Button Command="{Binding CacheAvailableMapsCommand}" Content="Cache available maps" />
                  <ProgressBar Width="130" IsIndeterminate="True" IsVisible="{Binding IsCheckingBeatSaver}" />
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="1*,1.8*,1.6*,1.1*,1.1*,1.1*,1.1*" ColumnSpacing="12">
                <TextBlock FontWeight="SemiBold" Text="Key" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Hash" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Song name" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Identity" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Installed on Quest" />
                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Cached locally" />
                <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Availability" />
              </Grid>
              <Border Height="1" Background="#3A404D" />
              <ItemsControl ItemsSource="{Binding SelectedPlaylistEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlaylistEntryStatusViewModel">
                    <Grid Margin="0,7" ColumnDefinitions="1*,1.8*,1.6*,1.1*,1.1*,1.1*,1.1*" ColumnSpacing="12" ToolTip.Tip="{Binding StatusMessage}">
                      <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Hash}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding SongName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding IdentityStatus}" />
                      <TextBlock Grid.Column="4" Text="{Binding InstalledOnQuest}" />
                      <TextBlock Grid.Column="5" Text="{Binding CachedLocally}" />
                      <TextBlock Grid.Column="6" Text="{Binding AvailabilityDisplay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Foreground="#AAB1C0" Text="Read-only view of PlaylistManager playlists" />
          <Border Padding="16" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="2*,2*,Auto,Auto,2*" ColumnSpacing="16">
                <TextBlock FontWeight="SemiBold" Text="Filename" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Playlist title" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Songs" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Format" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Warning" />
              </Grid>
              <Border Height="1" Background="#3A404D" />
              <TextBlock
                  IsVisible="{Binding !HasInstalledPlaylists}"
                  Margin="0,10"
                  Foreground="#8C94A5"
                  Text="No playlists found." />
              <ItemsControl ItemsSource="{Binding InstalledPlaylists}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:QuestInstalledPlaylist">
                    <Grid Margin="0,7" ColumnDefinitions="2*,2*,Auto,Auto,2*" ColumnSpacing="16">
                      <TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RemotePath}" />
                      <TextBlock Grid.Column="1" Text="{Binding PlaylistTitle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{Binding SongReferenceCount}" />
                      <TextBlock Grid.Column="3" Text="{Binding Format}" />
                      <TextBlock Grid.Column="4" Foreground="#D7A95B" Text="{Binding Warning}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSync}" Spacing="18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sync preview" />
              <TextBlock Foreground="#AAB1C0" Text="Generate and inspect a plan. Nothing is executed in this phase." />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding BuildSyncPlanCommand}"
                Content="Generate Sync Plan" />
          </Grid>

          <Border Padding="16" CornerRadius="8" Background="#31281D" BorderBrush="#D7A95B" BorderThickness="1">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#F0C979"
                Text="QBSync never deletes existing maps during normal sync." />
          </Border>

          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBuildingSyncPlan}" />
          <TextBlock
              IsVisible="{Binding !CanBuildSyncPlan}"
              Foreground="#D7A95B"
              Text="A completed Quest library scan is required before generating a trustworthy plan." />
          <TextBlock
              IsVisible="{Binding !HasSyncPlan}"
              Foreground="#8C94A5"
              Text="No plan generated yet. Import desired playlists, inspect availability, then generate a preview." />

          <StackPanel IsVisible="{Binding HasSyncPlan}" Spacing="14">
            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
              <Border Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="PLAYLIST REFERENCES" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncPlaylistReferences}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="UNIQUE MAPS" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncUniqueMaps}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="ALREADY INSTALLED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncAlreadyInstalled}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="DOWNLOAD REQUIRED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncDownloadRequired}" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
              <Border Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="UPLOAD REQUIRED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncUploadRequired}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="UNAVAILABLE" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncUnavailable}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="UNKNOWN" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncUnknown}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Padding="12" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#AAB1C0" Text="QUEST-ONLY PRESERVED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SyncQuestOnlyPreserved}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Padding="14" CornerRadius="8" BorderBrush="#5B9364" BorderThickness="1">
              <TextBlock
                  FontSize="18"
                  FontWeight="SemiBold"
                  Foreground="#83C98E"
                  Text="{Binding SyncDeletionCount, StringFormat='{}Deletion: {0}'}" />
            </Border>

            <Expander Header="Operations" IsExpanded="True">
              <Border Margin="0,10,0,0" Padding="14" CornerRadius="8" Background="#20242D">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="1.2*,2*,4*" ColumnSpacing="16">
                    <TextBlock FontWeight="SemiBold" Text="Operation" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Hash / playlist" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Details" />
                  </Grid>
                  <Border Height="1" Background="#3A404D" />
                  <ItemsControl ItemsSource="{Binding SyncOperations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:SyncOperation">
                        <Grid Margin="0,6" ColumnDefinitions="1.2*,2*,4*" ColumnSpacing="16">
                          <TextBlock Text="{Binding Kind}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding MapIdentity.Hash}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="#AAB1C0" Text="{Binding PlaylistName}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSettings}" Spacing="18">
          <Border Padding="20" CornerRadius="8" Background="#20242D">
            <StackPanel Spacing="12">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="ADB executable" />
              <TextBlock
                  Foreground="#AAB1C0"
                  Text="Optional. QBSync searches this path first, then the app-data tools directory, then PATH."
                  TextWrapping="Wrap" />
              <TextBox
                  Text="{Binding ConfiguredAdbPath}"
                  Watermark="Path to adb or its containing directory" />
              <Button
                  HorizontalAlignment="Left"
                  Command="{Binding SaveAdbPathCommand}"
                  Content="Save and check devices" />
              <TextBlock Foreground="#AAB1C0" Text="{Binding SettingsMessage}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock
            IsVisible="{Binding IsPlaceholderPage}"
            FontSize="16"
            Foreground="#8C94A5"
            Text="This section will be implemented in a later phase." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
