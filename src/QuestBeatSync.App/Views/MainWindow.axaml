<Window
    x:Class="QuestBeatSync.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:QuestBeatSync.Core.Models"
    xmlns:vm="using:QuestBeatSync.App.ViewModels"
    Title="QuestBeatSync"
    Background="#0B1F24"
    Foreground="#E8FFFF"
    Width="1000"
    Height="680"
    MinWidth="760"
    MinHeight="500"
    DragDrop.AllowDrop="True"
    DragDrop.DragOver="OnDragOver"
    DragDrop.Drop="OnDrop">
  <Grid ColumnDefinitions="220,*">
    <Border Background="#07161A" Padding="20,24">
      <Grid RowDefinitions="Auto,24,*">
        <StackPanel>
          <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="White" Text="QuestBeatSync" />
          <TextBlock Margin="0,4,0,0" Foreground="#9BA3B4" Text="Quest library manager" />
        </StackPanel>

        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding NavigationItems}"
            SelectedItem="{Binding SelectedPage}"
            Background="Transparent"
            BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <TextBlock Margin="12,10" FontSize="15" Foreground="White" Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="40,36" Spacing="24">
        <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}" />

        <Border
            IsVisible="{Binding HasOperationError}"
            Padding="14"
            CornerRadius="8"
            Background="#3A2024"
            BorderBrush="#E88A8A"
            BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock FontWeight="SemiBold" Foreground="#F2A0A0" Text="Operation failed" />
              <TextBlock Foreground="#F4C1C1" Text="{Binding OperationErrorText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding DismissOperationErrorCommand}"
                Content="Dismiss" />
          </Grid>
        </Border>

        <StackPanel IsVisible="{Binding IsDashboard}" Spacing="18">
          <Border Padding="20" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" Foreground="#A9DDE0" Text="DEVICE" />
                  <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Dashboard.DeviceStatus}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding Dashboard.RefreshDevicesCommand}"
                    Content="Refresh" />
              </Grid>

              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Dashboard.IsRefreshing}" />

              <StackPanel IsVisible="{Binding Dashboard.HasDevices}" Spacing="8">
                <TextBlock Foreground="#A9DDE0" Text="Device" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Dashboard.Devices}"
                    SelectedItem="{Binding Dashboard.SelectedDevice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:QuestDevice">
                      <Grid ColumnDefinitions="*,Auto" MinWidth="420">
                        <TextBlock Text="{Binding Serial}" />
                        <TextBlock Grid.Column="1" Margin="20,0,0,0" Foreground="#A9DDE0" Text="{Binding ConnectionState}" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    IsVisible="{Binding Dashboard.HasMultipleDevices}"
                    Foreground="#D7A95B"
                    Text="Multiple devices detected. Select the device to use." />
              </StackPanel>

              <Grid
                  IsVisible="{Binding Dashboard.HasSelectedDevice}"
                  ColumnDefinitions="Auto,24,*"
                  RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock Foreground="#A9DDE0" Text="Serial" />
                <TextBlock Grid.Column="2" Text="{Binding Dashboard.SelectedSerial}" />
                <TextBlock Grid.Row="2" Foreground="#A9DDE0" Text="State" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Dashboard.SelectedConnectionState}" />
                <TextBlock Grid.Row="4" Foreground="#A9DDE0" Text="Transport" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Dashboard.SelectedTransport}" />
                <TextBlock Grid.Row="6" Foreground="#A9DDE0" Text="Android model" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Dashboard.SelectedModel}" />
              </Grid>

              <TextBlock
                  IsVisible="{Binding Dashboard.HasErrorMessage}"
                  Foreground="#E88A8A"
                  Text="{Binding Dashboard.ErrorMessage}"
                  TextWrapping="Wrap" />

              <Button
                  IsVisible="{Binding Dashboard.IsAdbUnavailable}"
                  HorizontalAlignment="Left"
                  Command="{Binding OpenSettingsCommand}"
                  Content="Set ADB path" />
            </StackPanel>
          </Border>

          <Border Padding="20" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="#A9DDE0" Text="WIRELESS ADB" />
              <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                <TextBox Text="{Binding Dashboard.WirelessHost}" Watermark="Quest IPv4 address or hostname" />
                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="65535" Value="{Binding Dashboard.WirelessPort}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding Dashboard.ConnectCommand}" Content="Connect" />
                <Button Command="{Binding Dashboard.DisconnectCommand}" Content="Disconnect" />
                <Button Command="{Binding Dashboard.EnableWirelessCommand}" Content="Enable Wireless ADB on selected USB Quest" />
              </StackPanel>
              <TextBlock IsVisible="{Binding Dashboard.HasWirelessStatus}" Text="{Binding Dashboard.WirelessStatus}" TextWrapping="Wrap" />
              <TextBlock Foreground="#A9DDE0" Text="Classic TCP ADB only; pairing-code workflow is not yet supported." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Padding="20" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="#A9DDE0" Text="BEAT SABER ENVIRONMENT" />
              <Button HorizontalAlignment="Left" Command="{Binding Dashboard.ScanLibraryCommand}" Content="Scan Quest Library" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Dashboard.IsEnvironmentScanning}" />
              <TextBlock Foreground="#A9DDE0" Text="{Binding Library.ScanStateMessage}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Dashboard.BeatSaberStatus}" />
              <TextBlock Text="{Binding Dashboard.SongCoreStatus}" />
              <TextBlock Text="{Binding Dashboard.PlaylistManagerStatus}" />
              <TextBlock Text="{Binding Library.CustomLevelsDiagnostic, StringFormat='CustomLevels: {0}'}" />
              <TextBlock Text="{Binding Library.FoldersDiscovered, StringFormat='Folders discovered: {0}'}" />
              <TextBlock Text="{Binding Library.MapsScanned, StringFormat='Maps scanned: {0}'}" />
              <TextBlock Text="{Binding Library.HashIdentifiedCount, StringFormat='Hash identified: {0}'}" />
              <TextBlock Text="{Binding Library.LocalOrUnknownCount, StringFormat='Local / unknown: {0}'}" />
              <TextBlock Text="{Binding Library.ScanWarningCount, StringFormat='Warnings: {0}'}" />
              <TextBlock
                  IsVisible="{Binding Dashboard.HasEnvironmentError}"
                  Foreground="#E88A8A"
                  Text="{Binding Dashboard.EnvironmentError}"
                  TextWrapping="Wrap" />
              <TextBlock
                  IsVisible="{Binding Library.HasScanWarnings}"
                  Foreground="#D7A95B"
                  Text="{Binding Library.ScanWarningCount, StringFormat='{}{0} scan warning(s)'}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,18,*">
            <Border Padding="20" CornerRadius="8" Background="#12363B">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" Foreground="#A9DDE0" Text="LIBRARY" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Library.SongCount, StringFormat='{}{0} songs'}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="20" CornerRadius="8" Background="#12363B">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" Foreground="#A9DDE0" Text="PLAYLISTS" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Library.PlaylistCount, StringFormat='{}{0} playlists'}" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsLibrary}" Spacing="14">
          <TextBlock Foreground="#A9DDE0" Text="Read-only view of CustomLevels" />
          <Border Padding="16" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="2*,2*,1.5*,Auto,1.2*" ColumnSpacing="16">
                <TextBlock FontWeight="SemiBold" Text="Folder" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Song title" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Mapper" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Info.dat" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Identity" />
              </Grid>
              <Border Height="1" Background="#2C7378" />
              <TextBlock
                  IsVisible="{Binding !Library.HasInstalledMaps}"
                  Margin="0,10"
                  Foreground="#86B7BA"
                  Text="No custom songs found." />
              <ItemsControl ItemsSource="{Binding Library.InstalledMaps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:QuestInstalledMap">
                    <Grid Margin="0,7" ColumnDefinitions="2*,2*,1.5*,Auto,1.2*" ColumnSpacing="16">
                      <TextBlock Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RemotePath}" />
                      <TextBlock Grid.Column="1" Text="{Binding SongTitle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Mapper}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{Binding InfoDatExists}" />
                      <TextBlock Grid.Column="4" Text="{Binding IdentityStatus}" ToolTip.Tip="{Binding Warning}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPlaylists}" Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Local playlist imports" />
              <TextBlock Foreground="#A9DDE0" Text="Preview only — nothing is uploaded to Quest." />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="ImportPlaylist_Click"
                Content="Import Playlist" />
          </Grid>

          <Border Padding="18" CornerRadius="8" BorderBrush="#596273" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Drop one or more .bplist files here" />
              <TextBlock Foreground="#86B7BA" Text="BeatSaver playlists are read as UTF-8" />
              <ProgressBar Width="260" IsIndeterminate="True" IsVisible="{Binding Playlists.IsImporting}" />
            </StackPanel>
          </Border>

          <TextBlock
              IsVisible="{Binding Playlists.HasImportErrors}"
              Foreground="#E88A8A"
              Text="{Binding Playlists.ImportErrorText}"
              TextWrapping="Wrap" />

          <Grid IsVisible="{Binding Playlists.HasImportedPlaylists}" ColumnDefinitions="*,12,*,12,*">
            <Border Padding="14" CornerRadius="8" Background="#12363B">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#A9DDE0" Text="TOTAL PLAYLIST REFERENCES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Playlists.TotalPlaylistReferences}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#12363B">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#A9DDE0" Text="UNIQUE REQUIRED HASHES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Playlists.UniqueRequiredHashes}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="14" CornerRadius="8" Background="#12363B">
              <StackPanel Spacing="4">
                <TextBlock Foreground="#A9DDE0" Text="DUPLICATE REFERENCES" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Playlists.DuplicateReferences}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border IsVisible="{Binding Playlists.HasImportedPlaylists}" Padding="16" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="14">
              <ComboBox ItemsSource="{Binding Playlists.ImportedPlaylists}" SelectedItem="{Binding Playlists.SelectedPlaylist}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Playlist">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel IsVisible="{Binding Playlists.HasSelectedPlaylist}" Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Playlists.SelectedPlaylist.Name}" />
                <TextBlock FontSize="16" Foreground="#A9DDE0" Text="{Binding Playlists.SelectedAuthorDisplay}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="18">
                  <TextBlock Text="{Binding Playlists.SelectedEntryCount, StringFormat='{}{0} entries'}" />
                  <TextBlock Text="{Binding Playlists.SelectedUniqueHashCount, StringFormat='{}{0} unique hashes'}" />
                  <TextBlock Text="{Binding Playlists.SelectedDuplicateReferenceCount, StringFormat='{}{0} duplicate references'}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                  <Button Command="{Binding Playlists.CheckSelectedCommand}" Content="Check selected playlist" />
                  <Button Command="{Binding Playlists.CacheSelectedCommand}" Content="Cache selected available maps" />
                  <ProgressBar Width="130" IsIndeterminate="True" IsVisible="{Binding Playlists.IsChecking}" />
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="1*,1.8*,1.6*,1.1*,1.1*,1.1*,1.1*" ColumnSpacing="12">
                <TextBlock FontWeight="SemiBold" Text="Key" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Hash" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Song name" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Identity" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Installed on Quest" />
                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Cached locally" />
                <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Availability" />
              </Grid>
              <Border Height="1" Background="#2C7378" />
              <ItemsControl ItemsSource="{Binding Playlists.SelectedEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlaylistEntryStatusViewModel">
                    <Grid Margin="0,7" ColumnDefinitions="1*,1.8*,1.6*,1.1*,1.1*,1.1*,1.1*" ColumnSpacing="12" ToolTip.Tip="{Binding StatusMessage}">
                      <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Hash}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding SongName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding IdentityStatus}" />
                      <TextBlock Grid.Column="4" Text="{Binding InstalledOnQuest}" />
                      <TextBlock Grid.Column="5" Text="{Binding CachedLocally}" />
                      <TextBlock Grid.Column="6" Text="{Binding AvailabilityDisplay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Foreground="#A9DDE0" Text="Read-only view of PlaylistManager playlists" />
          <Border Padding="16" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="2*,2*,Auto,Auto,2*" ColumnSpacing="16">
                <TextBlock FontWeight="SemiBold" Text="Filename" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Playlist title" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Songs" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Format" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Warning" />
              </Grid>
              <Border Height="1" Background="#2C7378" />
              <TextBlock
                  IsVisible="{Binding !Library.HasInstalledPlaylists}"
                  Margin="0,10"
                  Foreground="#86B7BA"
                  Text="No playlists found." />
              <ItemsControl ItemsSource="{Binding Library.InstalledPlaylists}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:QuestInstalledPlaylist">
                    <Grid Margin="0,7" ColumnDefinitions="2*,2*,Auto,Auto,2*" ColumnSpacing="16">
                      <TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RemotePath}" />
                      <TextBlock Grid.Column="1" Text="{Binding PlaylistTitle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{Binding SongReferenceCount}" />
                      <TextBlock Grid.Column="3" Text="{Binding Format}" />
                      <TextBlock Grid.Column="4" Foreground="#D7A95B" Text="{Binding Warning}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSync}" Spacing="18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sync preview" />
              <TextBlock Foreground="#A9DDE0" Text="Generate, inspect, explicitly confirm, then execute the bound plan." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding Sync.BuildCommand}" Content="Build Sync Plan" />
              <Button Command="{Binding Sync.ReviewExecutionCommand}" Content="Review &amp; Execute" />
            </StackPanel>
          </Grid>

          <Border Padding="16" CornerRadius="8" Background="#31281D" BorderBrush="#D7A95B" BorderThickness="1">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#F0C979"
                Text="QBSync never deletes existing maps during normal sync." />
          </Border>

          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Sync.IsBuilding}" />
          <TextBlock
              IsVisible="{Binding Sync.IsBuilding}"
              Foreground="#A9DDE0"
              Text="{Binding Sync.ResolutionMessage}" />
          <TextBlock
              IsVisible="{Binding Sync.HasPlan}"
              Foreground="#55D98A"
              Text="{Binding Sync.ResolutionMessage}" />
          <TextBlock
              IsVisible="{Binding !Sync.CanBuild}"
              Foreground="#D7A95B"
              Text="A completed Quest library scan is required before generating a trustworthy plan." />
          <TextBlock
              IsVisible="{Binding !Sync.HasPlan}"
              Foreground="#86B7BA"
              Text="No plan generated yet. Import desired playlists, inspect availability, then generate a preview." />

          <StackPanel IsVisible="{Binding Sync.HasPlan}" Spacing="14">
            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
              <Border Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="PLAYLIST REFERENCES" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.PlaylistReferences}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="UNIQUE MAPS" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.UniqueMaps}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="ALREADY INSTALLED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.AlreadyInstalled}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="DOWNLOAD REQUIRED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.DownloadRequired}" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
              <Border Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="UPLOAD REQUIRED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.UploadRequired}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="UNAVAILABLE" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.Unavailable}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="UNKNOWN" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.Unknown}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Padding="12" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="3">
                  <TextBlock Foreground="#A9DDE0" Text="QUEST-ONLY PRESERVED" />
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Sync.QuestOnlyPreserved}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Padding="14" CornerRadius="8" BorderBrush="#5B9364" BorderThickness="1">
              <TextBlock
                  FontSize="18"
                  FontWeight="SemiBold"
                  Foreground="#55D98A"
                  Text="{Binding Sync.DeletionCount, StringFormat='{}Deletion: {0}'}" />
            </Border>

            <Border
                IsVisible="{Binding Sync.IsConfirmationVisible}"
                Padding="18"
                CornerRadius="8"
                Background="#31281D"
                BorderBrush="#D7A95B"
                BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock FontSize="19" FontWeight="SemiBold" Text="Confirm this exact SyncExecutionPlan" />
                <TextBlock Text="{Binding Sync.TargetSerial, StringFormat='{}Target Quest: {0}'}" />
                <TextBlock Text="{Binding Sync.AlreadyInstalled, StringFormat='{}Maps already installed: {0}'}" />
                <TextBlock Text="{Binding Sync.DownloadRequired, StringFormat='{}Maps to download: {0}'}" />
                <TextBlock Text="{Binding Sync.UploadRequired, StringFormat='{}Maps to upload: {0}'}" />
                <TextBlock Text="{Binding Sync.PlaylistsToTransfer, StringFormat='{}Playlists to transfer: {0}'}" />
                <TextBlock Text="{Binding Sync.QuestOnlyPreserved, StringFormat='{}Quest-only maps preserved: {0}'}" />
                <TextBlock Text="{Binding Sync.Unavailable, StringFormat='{}Unavailable maps skipped: {0}'}" />
                <TextBlock Text="{Binding Sync.Unknown, StringFormat='{}Unknown maps skipped: {0}'}" />
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#55D98A" Text="Maps to delete: 0" />
                <TextBlock Foreground="#D7A95B" Text="Beat Saber will be force-stopped. It will not be relaunched automatically." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding Sync.ConfirmExecutionCommand}" Content="Confirm and Execute" />
                  <Button Command="{Binding Sync.CancelConfirmationCommand}" Content="Back" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Expander Header="Operations" IsExpanded="True">
              <Border Margin="0,10,0,0" Padding="14" CornerRadius="8" Background="#12363B">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="1.2*,2*,4*" ColumnSpacing="16">
                    <TextBlock FontWeight="SemiBold" Text="Operation" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Hash / playlist" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Details" />
                  </Grid>
                  <Border Height="1" Background="#2C7378" />
                  <ItemsControl ItemsSource="{Binding Sync.Operations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:SyncOperation">
                        <Grid Margin="0,6" ColumnDefinitions="1.2*,2*,4*" ColumnSpacing="16">
                          <TextBlock Text="{Binding Kind}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding MapIdentity.Hash}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="#A9DDE0" Text="{Binding PlaylistName}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>

          <Border IsVisible="{Binding Sync.IsExecuting}" Padding="16" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="10">
              <ProgressBar IsIndeterminate="True" />
              <TextBlock Text="{Binding Sync.ProgressMessage}" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Left" Command="{Binding Sync.CancelExecutionCommand}" Content="Cancel remaining work" />
              <TextBlock Foreground="#A9DDE0" Text="Completed operations are preserved; cancel does not roll them back." />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding Sync.HasResult}" Padding="16" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="10">
              <TextBlock FontSize="19" FontWeight="SemiBold" Text="Execution result" />
              <TextBlock Text="{Binding Sync.ResultSummary}" TextWrapping="Wrap" />
              <TextBlock Foreground="#55D98A" Text="Start Beat Saber to let SongCore and PlaylistManager load transferred content." TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Sync.OperationResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:SyncOperationResult">
                    <Grid Margin="0,4" ColumnDefinitions="1.2*,1.2*,4*" ColumnSpacing="12">
                      <TextBlock Text="{Binding Status}" />
                      <TextBlock Grid.Column="1" Text="{Binding Operation.Kind}" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border IsVisible="{Binding Sync.HasDiagnosticWarnings}" Padding="10" Background="#31281D" CornerRadius="6">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Foreground="#D7A95B" Text="Diagnostic warnings" />
                  <TextBlock Foreground="#D7A95B" Text="{Binding Sync.DiagnosticWarningsText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSettings}" Spacing="18">
          <Border Padding="20" CornerRadius="8" Background="#12363B">
            <StackPanel Spacing="12">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="ADB Environment" />
              <Grid ColumnDefinitions="Auto,20,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto">
                <TextBlock Foreground="#A9DDE0" Text="Status" /><TextBlock Grid.Column="2" Text="{Binding Settings.EnvironmentStatus}" />
                <TextBlock Grid.Row="2" Foreground="#A9DDE0" Text="Source" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Settings.EnvironmentSource}" />
                <TextBlock Grid.Row="4" Foreground="#A9DDE0" Text="Version" /><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Settings.EnvironmentVersion}" />
                <TextBlock Grid.Row="6" Foreground="#A9DDE0" Text="Path" /><TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Settings.EnvironmentPath}" TextWrapping="Wrap" />
              </Grid>
              <TextBlock
                  Foreground="#A9DDE0"
                  Text="Choose an existing adb, or explicitly download an independent official Android Platform-Tools copy. QBSync does not modify PATH."
                  TextWrapping="Wrap" />
              <TextBox
                  Text="{Binding Settings.ConfiguredAdbPath}"
                  Watermark="Path to adb or its containing directory" />
              <Button
                  HorizontalAlignment="Left"
                  Click="ChooseAdb_Click"
                  Content="Choose adb executable..." />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding Settings.RecheckCommand}" Content="Recheck" />
                <Button Command="{Binding Settings.DownloadCommand}" Content="Download Platform-Tools" />
                <Button Command="{Binding Settings.UseAutomaticCommand}" Content="Use automatic selection" />
              </StackPanel>
              <TextBlock Foreground="#A9DDE0" Text="{Binding Settings.Message}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock
            IsVisible="{Binding IsPlaceholderPage}"
            FontSize="16"
            Foreground="#86B7BA"
            Text="This section will be implemented in a later phase." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
